{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sound training item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "name_ru", "ipa", "arpabet", "difficulty_for_russians", "typical_errors", "articulation_ru", "us_uk_note_ru", "example_words", "minimal_pairs", "phrases", "tongue_twisters"],
  "properties": {
    "id": { "enum": ["θ", "ð", "w", "v", "r", "h", "ŋ", "æ", "e", "ɪ", "iː", "ʊ", "uː", "ʌ", "ɑː", "ɒ", "ɔː", "ɜː", "ə", "eɪ", "aɪ", "ɔɪ", "əʊ", "aʊ", "ɪə", "eə", "final-voiced", "dark-l", "aspiration", "word-stress", "linking"] },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name_ru": { "type": "string", "minLength": 1 },
    "ipa": { "type": "string", "minLength": 1 },
    "arpabet": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{1,2}[0-2]?$" }, "uniqueItems": true, "description": "Matching ARPAbet phonemes; empty for prosodic items." },
    "difficulty_for_russians": { "type": "integer", "minimum": 1, "maximum": 3 },
    "typical_errors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["substitute", "heard_as_example", "tip_ru"],
        "properties": {
          "substitute": { "type": "string", "minLength": 1 },
          "heard_as_example": { "type": "string", "minLength": 1 },
          "tip_ru": { "type": "string", "minLength": 1 }
        }
      }
    },
    "articulation_ru": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
    "us_uk_note_ru": { "type": ["string", "null"] },
    "example_words": {
      "type": "array", "minItems": 12, "maxItems": 20,
      "description": "Graded easy to hard.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["word", "ipa_us", "ipa_uk", "translation_ru"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "ipa_us": { "type": "string", "minLength": 1 },
          "ipa_uk": { "type": "string", "minLength": 1 },
          "translation_ru": { "type": "string", "minLength": 1 }
        }
      }
    },
    "minimal_pairs": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "contrast", "contrast_sound"],
        "properties": {
          "target": { "type": "string", "minLength": 1, "description": "Word containing the target sound." },
          "contrast": { "type": "string", "minLength": 1, "description": "Word with the typical substituted sound." },
          "contrast_sound": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stress_pairs": {
      "type": "array", "minItems": 6, "maxItems": 12,
      "description": "Only for word-stress: noun/adjective stressed on the first syllable vs verb stressed on the second.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["first_stressed", "second_stressed", "ipa_us_first", "ipa_uk_first", "ipa_us_second", "ipa_uk_second", "translation_first_ru", "translation_second_ru"],
        "properties": {
          "first_stressed": { "type": "string" },
          "second_stressed": { "type": "string" },
          "ipa_us_first": { "type": "string" },
          "ipa_uk_first": { "type": "string" },
          "ipa_us_second": { "type": "string" },
          "ipa_uk_second": { "type": "string" },
          "translation_first_ru": { "type": "string" },
          "translation_second_ru": { "type": "string" }
        }
      }
    },
    "linking_phrases": {
      "type": "array", "minItems": 6, "maxItems": 12,
      "description": "Only for linking.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phrase", "ipa_linked", "type", "rule_ru", "translation_ru"],
        "properties": {
          "phrase": { "type": "string" },
          "ipa_linked": { "type": "string" },
          "type": { "enum": ["consonant-vowel", "linking-r", "intrusive-r", "j-glide", "w-glide", "same-consonant", "t-flap"] },
          "rule_ru": { "type": "string" },
          "translation_ru": { "type": "string" }
        }
      }
    },
    "phrases": { "type": "array", "minItems": 4, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
    "tongue_twisters": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "id": { "const": "word-stress" } }, "required": ["id"] },
      "then": { "required": ["stress_pairs"], "properties": { "minimal_pairs": { "maxItems": 0 }, "arpabet": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "id": { "const": "linking" } }, "required": ["id"] },
      "then": { "required": ["linking_phrases"], "properties": { "minimal_pairs": { "maxItems": 0 }, "arpabet": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "id": { "not": { "enum": ["word-stress", "linking"] } } }, "required": ["id"] },
      "then": { "properties": { "minimal_pairs": { "minItems": 6 } } }
    }
  ]
}
