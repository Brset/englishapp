  "typical_errors": [
    {
      "substitute": "короткое «а»",
      "heard_as_example": "calm → cam",
      "tip_ru": "Звук должен быть долгим и глубоким. Рот открыт широко, звук идёт из глубины."
    },
    {
      "substitute": "æ",
      "heard_as_example": "hard → had",
      "tip_ru": "Не растягивайте губы в стороны. Челюсть опущена вниз, язык лежит низко и отодвинут назад."
