  "typical_errors": [
    {
      "substitute": "о (ровное «о»)",
      "heard_as_example": "go → «го»",
      "tip_ru": "В английском это дифтонг: звук начинается нейтрально и скользит к «у». Русское «о» ровное и слишком чистое."
    },
    {
      "substitute": "ɔː",
      "heard_as_example": "low → law",
      "tip_ru": "Не растягивайте «о» и не тяните его. Скольжение ведёт к «у», а не остаётся на месте."
    },
    {
      "substitute": "оу с сильным округлением в начале",
      "heard_as_example": "no → «ноу» (сильное «о»)",
      "tip_ru": "Начало звука нейтральное, губы не сильно округлены. Округление растёт к концу."
    }
  ],
  "articulation_ru": [
    "Начните с нейтрального положения: рот приоткрыт, губы расслаблены, как для ə.",
