<!-- Design tokens shared with the Android app (android/.../ui/theme). Light/Dark via ThemeDictionaries. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#4655D4</Color>
            <Color x:Key="SystemAccentColorLight1">#5F6DE0</Color>
            <Color x:Key="SystemAccentColorLight2">#7C88EA</Color>
            <Color x:Key="SystemAccentColorLight3">#9EA7F3</Color>
            <Color x:Key="SystemAccentColorDark1">#3A48BF</Color>
            <Color x:Key="SystemAccentColorDark2">#2F3BA8</Color>
            <Color x:Key="SystemAccentColorDark3">#242E87</Color>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#4655D4" />
            <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#E0E3FF" />
            <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#1B2585" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#00897B" />
            <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#EEEFF6" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#C5C7D3" />
            <SolidColorBrush x:Key="ScoreGoodBrush" Color="#2E9E5B" />
            <SolidColorBrush x:Key="ScoreFairBrush" Color="#D99A00" />
            <SolidColorBrush x:Key="ScorePoorBrush" Color="#D64545" />
            <SolidColorBrush x:Key="ScoreMissingBrush" Color="#9AA0AE" />
            <SolidColorBrush x:Key="LevelA1Brush" Color="#2E9E5B" />
            <SolidColorBrush x:Key="LevelA2Brush" Color="#00897B" />
            <SolidColorBrush x:Key="LevelB1Brush" Color="#1E88E5" />
            <SolidColorBrush x:Key="LevelB2Brush" Color="#4655D4" />
            <SolidColorBrush x:Key="LevelC1Brush" Color="#8E44AD" />
            <SolidColorBrush x:Key="LevelC2Brush" Color="#C2185B" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#E0E3FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#B8C0FF</Color>
            <Color x:Key="SystemAccentColorLight1">#C6CCFF</Color>
            <Color x:Key="SystemAccentColorLight2">#D4D8FF</Color>
            <Color x:Key="SystemAccentColorLight3">#E0E3FF</Color>
            <Color x:Key="SystemAccentColorDark1">#9DA7F5</Color>
            <Color x:Key="SystemAccentColorDark2">#7C88EA</Color>
            <Color x:Key="SystemAccentColorDark3">#5F6DE0</Color>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#B8C0FF" />
            <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#2F3BA8" />
            <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#E0E3FF" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#6FD8C8" />
            <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#2A2C35" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#5A5D6B" />
            <SolidColorBrush x:Key="ScoreGoodBrush" Color="#5BD08A" />
            <SolidColorBrush x:Key="ScoreFairBrush" Color="#F2C14E" />
            <SolidColorBrush x:Key="ScorePoorBrush" Color="#FF7A7A" />
            <SolidColorBrush x:Key="ScoreMissingBrush" Color="#7D8292" />
            <SolidColorBrush x:Key="LevelA1Brush" Color="#5BD08A" />
            <SolidColorBrush x:Key="LevelA2Brush" Color="#6FD8C8" />
            <SolidColorBrush x:Key="LevelB1Brush" Color="#7FBFFF" />
            <SolidColorBrush x:Key="LevelB2Brush" Color="#B8C0FF" />
            <SolidColorBrush x:Key="LevelC1Brush" Color="#D7A6F0" />
            <SolidColorBrush x:Key="LevelC2Brush" Color="#FF8FB8" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#262D6E" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing / radii -->
    <x:Double x:Key="PageMaxWidth">1040</x:Double>
    <x:Double x:Key="ReadingMaxWidth">760</x:Double>
    <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="HeroCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">24</CornerRadius>
    <FontFamily x:Key="ReadingFontFamily">Georgia, Sitka Text, Cambria</FontFamily>

    <!-- Card: Border with surface background, subtle stroke, 12px radius, 20px padding -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <!-- Hero: accent-tinted card for the main call to action of a page -->
    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HeroBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource HeroCornerRadius}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <!-- Small rounded label (level, genre, status) -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="BigNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
