<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EnglishApp</RootNamespace>
    <AssemblyName>EnglishApp</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Native inputs. Override on the command line: -p:NativeDll=... -p:ContentDb=... -->
  <PropertyGroup>
    <NativeDll Condition="'$(NativeDll)' == ''">$(MSBuildThisFileDirectory)..\..\build\native\Release\pron.dll</NativeDll>
    <ContentDb Condition="'$(ContentDb)' == ''">$(MSBuildThisFileDirectory)..\..\build\content.db</ContentDb>
    <UserSchema Condition="'$(UserSchema)' == ''">$(MSBuildThisFileDirectory)..\..\content\db\user_schema.sql</UserSchema>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NativeDll)" Condition="Exists('$(NativeDll)')" Link="pron.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ContentDb)" Condition="Exists('$(ContentDb)')" Link="content.db" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(UserSchema)" Condition="Exists('$(UserSchema)')" Link="user_schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
