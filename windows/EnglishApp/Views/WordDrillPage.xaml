<Page x:Class="EnglishApp.Views.WordDrillPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Тренировка слов" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Current.Word, Mode=OneWay, FallbackValue=''}" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Current.Ipa, Mode=OneWay, FallbackValue=''}" FontSize="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Current.TranslationRu, Mode=OneWay, FallbackValue=''}" FontSize="20" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Послушать" Command="{x:Bind ViewModel.ListenCommand}" />
                        <Button Content="Сказать" Command="{x:Bind ViewModel.SayCommand}" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" FontSize="44" FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.ResultBrush, Mode=OneWay}" />
                            <TextBlock Text="из 100" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.HeardText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Suggestion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Снова" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="1" />
                            <Button Content="Трудно" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="3" />
                            <Button Content="Хорошо" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="4" />
                            <Button Content="Легко" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="5" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Сейчас повторять нечего. Слова с низкой оценкой попадают сюда автоматически после чтения, а ещё слова можно сохранять, нажав на них в тексте."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Открыть словарь" Click="OnVocab" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
