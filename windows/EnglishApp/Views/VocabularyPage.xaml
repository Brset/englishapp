<Page x:Class="EnglishApp.Views.VocabularyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Словарь" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.DueText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <Border Grid.Row="2" Padding="20" CornerRadius="8" Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Current.Word, Mode=OneWay, FallbackValue=''}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Current.Ipa, Mode=OneWay, FallbackValue=''}" FontSize="18" />
                <Button Content="Произнести" Command="{x:Bind ViewModel.SpeakCommand}" />
                <Button Content="Показать перевод" Command="{x:Bind ViewModel.RevealCommand}"
                        Visibility="{x:Bind ViewModel.ShowReveal, Mode=OneWay}" />
                <StackPanel Visibility="{x:Bind ViewModel.IsRevealed, Mode=OneWay}" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Current.TranslationRu, Mode=OneWay, FallbackValue=''}" FontSize="20" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Не помню" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="1" />
                        <Button Content="Трудно" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="3" />
                        <Button Content="Хорошо" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="4" />
                        <Button Content="Легко" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="5" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Words}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:SavedWord">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Word}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Ipa}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind TranslationRu}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="3" Text="{x:Bind DueText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="4" Content="Удалить" Click="OnDelete" Tag="{x:Bind Id}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
