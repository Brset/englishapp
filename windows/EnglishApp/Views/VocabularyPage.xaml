<Page x:Class="EnglishApp.Views.VocabularyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models"
      xmlns:vm="using:EnglishApp.ViewModels">
    <Page.Resources>
        <Style x:Key="VocabIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="VocabGradeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}"
                    HorizontalAlignment="Stretch" Spacing="24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Словарь" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Слова, сохранённые во время чтения. Повторяйте их понемногу каждый день — карточки сами напомнят о себе."
                           Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource PrimaryContainerBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DueText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind ViewModel.HasWords, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.WordsCountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Flashcard (spaced repetition) -->
            <Border Style="{StaticResource HeroCardStyle}" Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                    <TextBlock Text="Карточка для повторения" Style="{StaticResource CaptionSecondaryStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Current.Word, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource BigNumberStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Current.Ipa, Mode=OneWay, FallbackValue=''}" FontSize="18"
                                       FontFamily="Segoe UI" Foreground="{ThemeResource PrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SpeakCommand}" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Произнести">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE767;" FontSize="14" />
                                <TextBlock Text="Произнести" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button Content="Показать перевод" Command="{x:Bind ViewModel.RevealCommand}"
                            Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0"
                            Visibility="{x:Bind ViewModel.ShowReveal, Mode=OneWay}" />

                    <StackPanel Visibility="{x:Bind ViewModel.IsRevealed, Mode=OneWay}" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Current.TranslationRu, Mode=OneWay, FallbackValue=''}" FontSize="20"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Насколько легко вы вспомнили?" Style="{StaticResource CaptionSecondaryStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource VocabGradeButtonStyle}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ScorePoorBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Не помню" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource VocabGradeButtonStyle}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ScoreFairBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Трудно" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource VocabGradeButtonStyle}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ScoreGoodBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Хорошо" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource VocabGradeButtonStyle}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Легко" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource CardStyle}" Padding="32,40" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                            Background="{ThemeResource PrimaryContainerBrush}">
                        <FontIcon Glyph="&#xE82D;" FontSize="30" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                    </Border>
                    <TextBlock Text="Словарь пока пуст" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Во время чтения нажмите на незнакомое слово и сохраните его — оно появится здесь вместе с переводом и транскрипцией."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Открыть библиотеку" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Click="OnOpenLibrary" />
                </StackPanel>
            </Border>

            <!-- All words -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasWords, Mode=OneWay}">
                <TextBlock Text="Все слова" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Words}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="m:SavedWord">
                            <Border Style="{StaticResource CardStyle}" Padding="20,12,12,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Word}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind vm:VocabularyViewModel.IpaText(Ipa)}" FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind TranslationRu}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource PrimaryContainerBrush}"
                                                Visibility="{x:Bind vm:VocabularyViewModel.DueVisibility(DueAt)}">
                                            <TextBlock Text="Пора повторить" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipStyle}"
                                                Visibility="{x:Bind vm:VocabularyViewModel.NotDueVisibility(DueAt)}">
                                            <TextBlock Text="{x:Bind vm:VocabularyViewModel.NextReviewText(DueText)}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipStyle}">
                                            <TextBlock Text="{x:Bind vm:VocabularyViewModel.RepsText(Reps)}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VocabIconButtonStyle}" Click="OnSpeakWord" Tag="{x:Bind Word}"
                                                ToolTipService.ToolTip="Произнести">
                                            <FontIcon Glyph="&#xE767;" FontSize="16" />
                                        </Button>
                                        <Button Style="{StaticResource VocabIconButtonStyle}" Click="OnDelete" Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="Удалить из словаря">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
