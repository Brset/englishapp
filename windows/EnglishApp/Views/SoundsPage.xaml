<Page x:Class="EnglishApp.Views.SoundsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models"
      xmlns:vm="using:EnglishApp.ViewModels">
    <Grid Padding="32" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Звуки" Style="{StaticResource TitleTextBlockStyle}" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sounds}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:SoundCard">
                        <TextBlock Text="{x:Bind Title}" Padding="0,6" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <Button Content="Тренировать звук" Click="OnDrill" Style="{StaticResource AccentButtonStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Details}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailLine">
                            <StackPanel Padding="0,0,0,12">
                                <TextBlock Text="{x:Bind Heading}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
