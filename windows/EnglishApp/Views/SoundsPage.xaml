<Page x:Class="EnglishApp.Views.SoundsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:EnglishApp.Views"
      xmlns:m="using:EnglishApp.Models"
      xmlns:vm="using:EnglishApp.ViewModels">
    <Page.Resources>
        <Style x:Key="SoundsPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SoundsTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" MaxWidth="1240" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Звуки" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Звуки английского, которые чаще всего даются русскоговорящим труднее всего."
                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="376" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sound grid -->
            <GridView ItemsSource="{x:Bind ViewModel.Sounds}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                      SelectionMode="Single" Padding="0,0,4,0">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="m:SoundCard">
                        <Border Width="170" Height="180" Padding="14" CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Left"
                                        Background="{ThemeResource PrimaryContainerBrush}">
                                    <Viewbox MaxWidth="40" MaxHeight="28" StretchDirection="DownOnly">
                                        <TextBlock Text="{x:Bind vm:SoundsViewModel.ShortIpa(Ipa)}" FontSize="22" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{x:Bind NameRu}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind vm:SoundsViewModel.Brief(Json)}" Style="{StaticResource CaptionSecondaryStyle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind vm:SoundsViewModel.DifficultyText(Json)}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource PrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Detail -->
            <ScrollViewer Grid.Column="1">
                <Grid Padding="0,0,12,24" MaxWidth="{StaticResource ReadingMaxWidth}" HorizontalAlignment="Stretch">
                    <!-- Nothing selected -->
                    <Border Style="{StaticResource CardStyle}" Padding="32,40" VerticalAlignment="Top"
                            Visibility="{x:Bind local:SoundsPage.VisibleWhenFalse(ViewModel.HasSelected), Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                    Background="{ThemeResource PrimaryContainerBrush}">
                                <FontIcon Glyph="&#xE767;" FontSize="30" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="Здесь появится объяснение артикуляции, минимальные пары и скороговорки."
                                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.HasSelected, Mode=OneWay}">
                        <!-- Hero -->
                        <Border Style="{StaticResource HeroCardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="96" CornerRadius="48" VerticalAlignment="Top"
                                        Background="{ThemeResource PrimaryContainerBrush}"
                                        BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="2">
                                    <Viewbox MaxWidth="72" MaxHeight="48" StretchDirection="DownOnly">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedIpa, Mode=OneWay}" FontSize="40" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource ChipStyle}">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDifficulty, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" Click="OnSpeak"
                                            Tag="{x:Bind ViewModel.ExamplesSpeakText, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasExamples, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Послушать примеры" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Articulation -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasArticulation, Mode=OneWay}">
                            <TextBlock Text="Как произносить" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Articulation}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SoundStep">
                                            <Grid ColumnSpacing="14" Padding="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                                        Background="{ThemeResource PrimaryContainerBrush}">
                                                    <TextBlock Text="{x:Bind NumberText}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           IsTextSelectionEnabled="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" CornerRadius="{StaticResource CardCornerRadius}" Padding="16,12"
                                    Visibility="{x:Bind ViewModel.HasUsUkNote, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Foreground="{ThemeResource PrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="США и Великобритания" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.UsUkNote, Mode=OneWay}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Typical errors -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasErrors, Mode=OneWay}">
                            <TextBlock Text="Типичные ошибки" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SoundError">
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                                          Foreground="{ThemeResource ScoreFairBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind SubstituteText}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind HeardAsText}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Tip}" TextWrapping="Wrap" Margin="0,4,0,0" IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Minimal pairs -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasMinimalPairs, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="Минимальные пары" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="Слова отличаются одним звуком. Нажмите, чтобы услышать разницу."
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.MinimalPairs}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="150" MinItemHeight="36" MinColumnSpacing="8" MinRowSpacing="8"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SoundPair">
                                        <Button Style="{StaticResource SoundsPillButtonStyle}" Click="OnSpeak" Tag="{x:Bind SpeakText}"
                                                ToolTipService.ToolTip="{x:Bind SpeakText}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Label}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Example words -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasExamples, Mode=OneWay}">
                            <TextBlock Text="Слова-примеры" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Examples}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="160" MinItemHeight="84" MinColumnSpacing="8" MinRowSpacing="8"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SoundExample">
                                        <Button Style="{StaticResource SoundsTileButtonStyle}" Click="OnSpeak" Tag="{x:Bind Word}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Word}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind IpaText}" FontFamily="Segoe UI" Foreground="{ThemeResource PrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Translation}" Style="{StaticResource CaptionSecondaryStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Phrases -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasPhrases, Mode=OneWay}">
                            <TextBlock Text="Фразы для тренировки" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}" Padding="20,8">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Phrases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SoundLine">
                                            <Grid ColumnSpacing="12" Padding="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Text}" FontFamily="{StaticResource ReadingFontFamily}" FontSize="18"
                                                           LineHeight="28" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                                <Button Grid.Column="1" Click="OnSpeak" Tag="{x:Bind Text}" Padding="8"
                                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Послушать">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Tongue twisters -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasTongueTwisters, Mode=OneWay}">
                            <TextBlock Text="Скороговорки" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TongueTwisters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SoundLine">
                                        <Border Margin="0,0,0,12" Padding="24,18" CornerRadius="{StaticResource CardCornerRadius}"
                                                Background="{ThemeResource SurfaceVariantBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Text}" FontFamily="{StaticResource ReadingFontFamily}" FontSize="20"
                                                           LineHeight="32" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           IsTextSelectionEnabled="True" />
                                                <Button Grid.Column="1" Click="OnSpeak" Tag="{x:Bind Text}" Padding="8" VerticalAlignment="Center"
                                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Послушать">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Anything else in the card (stress pairs, linking phrases, ...) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasExtraDetails, Mode=OneWay}">
                            <TextBlock Text="Дополнительно" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ExtraDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DetailLine">
                                            <StackPanel Padding="0,0,0,16" Spacing="4">
                                                <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
