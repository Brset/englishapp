<Page x:Class="EnglishApp.Views.ReadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <Grid Padding="32,24,32,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Text.TitleEn, Mode=OneWay, FallbackValue='Чтение'}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Text.TitleRu, Mode=OneWay, FallbackValue=''}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasCoverage, Mode=OneWay}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72" VerticalAlignment="Top">
                    <ProgressRing IsActive="True" IsIndeterminate="False" Minimum="0" Maximum="100" Width="72" Height="72"
                                  Value="{x:Bind ViewModel.CoveragePct, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CoveragePct, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.CoverageLine, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsPending, Mode=OneWay}" Width="18" Height="18"
                                      Visibility="{x:Bind ViewModel.BadgeVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Badge, Mode=OneWay}" VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.BadgeVisibility, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ScoreVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.HistoryText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HistoryVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Подробный разбор" Click="OnReview" Margin="0,6,0,0"
                            Visibility="{x:Bind ViewModel.ReviewVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Записать чтение" Click="OnRecord" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasText, Mode=OneWay}" />
                <Button Content="{x:Bind ViewModel.ResumeLabel, Mode=OneWay}" Click="OnResume"
                        Visibility="{x:Bind ViewModel.CanResume, Mode=OneWay}" />
                <Button Content="По абзацам" Click="OnParagraphs" IsEnabled="{x:Bind ViewModel.HasText, Mode=OneWay}" />
                <Button Content="Целиком" Click="OnWhole" IsEnabled="{x:Bind ViewModel.HasText, Mode=OneWay}" />
                <Button Content="Шэдоуинг" Click="OnShadowing" IsEnabled="{x:Bind ViewModel.HasText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Озвучить текст" Command="{x:Bind ViewModel.SpeakAllCommand}" />
                <Button Content="Стоп" Command="{x:Bind ViewModel.StopCommand}" />
                <TextBlock Text="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}" VerticalAlignment="Center" />
                <Slider Width="160" Minimum="0.5" Maximum="1.25" StepFrequency="0.25" TickFrequency="0.25"
                        TickPlacement="Outside" Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
                <ComboBox Header="Шрифт" Width="80" ItemsSource="{x:Bind ViewModel.Typo.FontSizeNames}"
                          SelectedIndex="{x:Bind ViewModel.Typo.FontSizeIndex, Mode=TwoWay}" />
                <ComboBox Header="Интервал" Width="120" ItemsSource="{x:Bind ViewModel.Typo.LineSpacingNames}"
                          SelectedIndex="{x:Bind ViewModel.Typo.LineSpacingIndex, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <RichTextBlock x:Name="Body" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Tapped="OnBodyTapped"
                           FontSize="{x:Bind ViewModel.Typo.BodyFontSize, Mode=OneWay}"
                           LineHeight="{x:Bind ViewModel.Typo.BodyLineHeight, Mode=OneWay}" />
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.NoText, Mode=OneWay}">
            <FontIcon Glyph="&#xE736;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Выберите текст в библиотеке" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <Button Content="Открыть библиотеку" Click="OnShowLibrary" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <ItemsControl Grid.Row="4" ItemsSource="{x:Bind ViewModel.Focus}" MaxHeight="140">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:FocusSound">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Звук /" /><Run Text="{x:Bind Sound}" /><Run Text="/: " /><Run Text="{x:Bind TipRu}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
