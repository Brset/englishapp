<Page x:Class="EnglishApp.Views.ReadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Text.TitleEn, Mode=OneWay, FallbackValue='Чтение'}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Text.TitleRu, Mode=OneWay, FallbackValue='Выберите текст в библиотеке'}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
            <Button Content="Озвучить текст" Command="{x:Bind ViewModel.SpeakAllCommand}" />
            <Button Content="Стоп" Command="{x:Bind ViewModel.StopCommand}" />
            <TextBlock Text="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}" VerticalAlignment="Center" />
            <Slider Width="200" Minimum="0.5" Maximum="1.25" StepFrequency="0.25" TickFrequency="0.25"
                    TickPlacement="Outside" Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
            <Button Content="Записать чтение" Click="OnRecord" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <RichTextBlock x:Name="Body" FontSize="20" LineHeight="32" TextWrapping="Wrap" MaxWidth="900"
                           HorizontalAlignment="Left" Tapped="OnBodyTapped" />
        </ScrollViewer>
        <ItemsControl Grid.Row="3" ItemsSource="{x:Bind ViewModel.Focus}" MaxHeight="140">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:FocusSound">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Звук /" /><Run Text="{x:Bind Sound}" /><Run Text="/: " /><Run Text="{x:Bind TipRu}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
