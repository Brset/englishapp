<Page x:Class="EnglishApp.Views.ReadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <Page.Resources>
        <!-- Small square icon button for the reading toolbar -->
        <Style x:Key="ReadingToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid Padding="{StaticResource PagePadding}">
                <!-- Empty state: no text selected -->
                <StackPanel Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" Margin="0,80,0,0" MaxWidth="420">
                    <FontIcon Glyph="&#xE736;" FontSize="48" HorizontalAlignment="Center"
                              Foreground="{ThemeResource PrimaryBrush}" />
                    <TextBlock Text="Чтение" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Выберите текст в библиотеке — он откроется здесь в удобном режиме чтения."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Click="OnOpenLibrary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                            <TextBlock Text="Открыть библиотеку" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Reader column -->
                <StackPanel Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                            MaxWidth="{StaticResource ReadingMaxWidth}" HorizontalAlignment="Stretch" Spacing="16">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!-- Header -->
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{x:Bind LevelBrush(ViewModel.Text), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.Text.Level, Mode=OneWay, FallbackValue=''}"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}">
                                <TextBlock Text="{x:Bind ViewModel.Text.Genre, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Text.TitleEn, Mode=OneWay, FallbackValue='Чтение'}"
                                   Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Text.TitleRu, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Badge / score pills -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource ChipStyle}" Padding="12,6"
                                    Visibility="{x:Bind ViewModel.BadgeVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsPending, Mode=OneWay}" Width="16" Height="16" />
                                    <TextBlock Text="{x:Bind ViewModel.Badge, Mode=OneWay}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" Padding="12,6"
                                    Background="{ThemeResource PrimaryContainerBrush}"
                                    Visibility="{x:Bind ViewModel.ScoreVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Click="OnReview" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ReviewVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                    <TextBlock Text="Подробный разбор" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.HistoryText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HistoryVisibility, Mode=OneWay}"
                                   Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>

                    <!-- Reading body -->
                    <Border Style="{StaticResource CardStyle}" Padding="40,32,40,28">
                        <RichTextBlock x:Name="Body" FontFamily="{StaticResource ReadingFontFamily}"
                                       FontSize="20" LineHeight="32" TextWrapping="Wrap"
                                       HorizontalAlignment="Stretch" Tapped="OnBodyTapped" />
                    </Border>
                    <TextBlock Text="Нажмите на слово, чтобы увидеть перевод и произношение."
                               Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Center" />

                    <!-- Focus sounds -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.FocusVisibility, Mode=OneWay}">
                        <TextBlock Text="Звуки в фокусе" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Focus}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="220" MinColumnSpacing="12" MinRowSpacing="12"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="m:FocusSound">
                                    <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Left"
                                                    Background="{ThemeResource PrimaryContainerBrush}">
                                                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource OnPrimaryContainerBrush}">
                                                    <Run Text="/" /><Run Text="{x:Bind Sound}" /><Run Text="/" />
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{x:Bind TipRu}" TextWrapping="Wrap"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Sticky bottom toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,8"
                Margin="32,8,32,20" MaxWidth="{StaticResource PageMaxWidth}"
                Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Style="{StaticResource ReadingToolbarIconButtonStyle}"
                            Command="{x:Bind ViewModel.SpeakAllCommand}"
                            ToolTipService.ToolTip="Озвучить текст" AutomationProperties.Name="Озвучить текст">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource ReadingToolbarIconButtonStyle}"
                            Command="{x:Bind ViewModel.StopCommand}"
                            ToolTipService.ToolTip="Стоп" AutomationProperties.Name="Стоп">
                        <FontIcon Glyph="&#xE71A;" FontSize="16" />
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="28" VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}"
                               Style="{StaticResource CaptionSecondaryStyle}" />
                    <Slider Width="160" Minimum="0.5" Maximum="1.25" StepFrequency="0.25" TickFrequency="0.25"
                            TickPlacement="Outside" Value="{x:Bind ViewModel.Speed, Mode=TwoWay}"
                            AutomationProperties.Name="Скорость озвучки" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Записать чтение" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button Click="OnRecord" Style="{StaticResource AccentButtonStyle}"
                            Width="56" Height="56" CornerRadius="28" Padding="0"
                            ToolTipService.ToolTip="Записать чтение" AutomationProperties.Name="Записать чтение">
                        <FontIcon Glyph="&#xE720;" FontSize="22" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
