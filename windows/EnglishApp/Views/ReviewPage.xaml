<Page x:Class="EnglishApp.Views.ReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:EnglishApp.Views"
      xmlns:vm="using:EnglishApp.ViewModels"
      xmlns:n="using:EnglishApp.Native">
    <Page.Resources>
        <Style x:Key="ReviewMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ReviewMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReviewMetricNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource BigNumberStyle}">
            <Setter Property="Margin" Value="0,6,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}"
                    HorizontalAlignment="Stretch" Spacing="16">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Разбор" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Как прозвучало ваше чтение: общий балл, слова и отдельные звуки."
                           Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Empty state (visibility is set from code-behind) -->
            <Border x:Name="Empty" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="32,40">
                <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                            Background="{ThemeResource PrimaryContainerBrush}">
                        <FontIcon Glyph="&#xE720;" FontSize="30" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                    </Border>
                    <TextBlock Text="Пока нет результатов" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Пока нет результатов. Запишите чтение текста — здесь появится подробный разбор произношения."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Выбрать текст" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnOpenLibrary" />
                </StackPanel>
            </Border>

            <!-- Result -->
            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar IsOpen="{x:Bind ViewModel.HasNotes, Mode=OneWay}" Severity="Warning" IsClosable="False"
                             Title="Обратите внимание" Message="{x:Bind ViewModel.Notes, Mode=OneWay}" />

                    <!-- Overall score -->
                    <Border Style="{StaticResource HeroCardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="120" Height="120">
                                <ProgressRing Width="120" Height="120" IsActive="True" IsIndeterminate="False"
                                              Minimum="0" Maximum="100"
                                              Value="{x:Bind ViewModel.OverallValue, Mode=OneWay}"
                                              Foreground="{x:Bind ViewModel.OverallBrush, Mode=OneWay}"
                                              Background="{ThemeResource SurfaceVariantBrush}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Overall, Mode=OneWay}" Style="{StaticResource BigNumberStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="из 100" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Итоговый балл" Style="{StaticResource CaptionSecondaryStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.OverallLabel, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.OverallHint, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metric cards -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ReviewMetricCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Точность" Style="{StaticResource ReviewMetricLabelStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Accuracy, Mode=OneWay}" Style="{StaticResource ReviewMetricNumberStyle}"
                                           Foreground="{x:Bind ViewModel.AccuracyBrush, Mode=OneWay}" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.AccuracyValue, Mode=OneWay}"
                                             Foreground="{x:Bind ViewModel.AccuracyBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReviewMetricCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Полнота" Style="{StaticResource ReviewMetricLabelStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Completeness, Mode=OneWay}" Style="{StaticResource ReviewMetricNumberStyle}"
                                           Foreground="{x:Bind ViewModel.CompletenessBrush, Mode=OneWay}" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.CompletenessValue, Mode=OneWay}"
                                             Foreground="{x:Bind ViewModel.CompletenessBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ReviewMetricCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Беглость" Style="{StaticResource ReviewMetricLabelStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Fluency, Mode=OneWay}" Style="{StaticResource ReviewMetricNumberStyle}"
                                           Foreground="{x:Bind ViewModel.FluencyBrush, Mode=OneWay}" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.FluencyValue, Mode=OneWay}"
                                             Foreground="{x:Bind ViewModel.FluencyBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource ReviewMetricCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC4A;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Темп" Style="{StaticResource ReviewMetricLabelStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Wpm, Mode=OneWay}" Style="{StaticResource ReviewMetricNumberStyle}" />
                                <TextBlock Text="слов в минуту" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fluency details as chips -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource ChipStyle}">
                            <TextBlock Text="{x:Bind ViewModel.PausesText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border Style="{StaticResource ChipStyle}">
                            <TextBlock Text="{x:Bind ViewModel.RepetitionsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border Style="{StaticResource ChipStyle}">
                            <TextBlock Text="{x:Bind ViewModel.HesitationsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Coloured text -->
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Текст" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Нажмите на слово, чтобы увидеть разбор по звукам." Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                        <!-- Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind ViewModel.GoodBrush, Mode=OneWay}" />
                                <TextBlock Text="хорошо (80+)" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind ViewModel.FairBrush, Mode=OneWay}" />
                                <TextBlock Text="средне (60–79)" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind ViewModel.PoorBrush, Mode=OneWay}" />
                                <TextBlock Text="плохо (&lt;60)" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind ViewModel.MissingBrush, Mode=OneWay}" />
                                <TextBlock Text="пропущено" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource CardStyle}" Padding="32,28">
                        <RichTextBlock x:Name="Words" FontFamily="{StaticResource ReadingFontFamily}" FontSize="20" LineHeight="32"
                                       TextWrapping="Wrap" MaxWidth="{StaticResource ReadingMaxWidth}" HorizontalAlignment="Left"
                                       Tapped="OnWordsTapped" />
                    </Border>
                </StackPanel>

                <!-- Selected word: phonemes -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Звуки слова" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8D2;" FontSize="18" VerticalAlignment="Center"
                                          Foreground="{ThemeResource PrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.WordTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WordSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}"
                                       TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasWordSelection, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Phonemes}" Margin="0,12,0,0"
                                          Visibility="{x:Bind ViewModel.HasPhonemes, Mode=OneWay}">
                                <ItemsControl.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                                    </TransitionCollection>
                                </ItemsControl.ItemContainerTransitions>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PhonemeRow">
                                        <Grid ColumnSpacing="16" Padding="0,10" BorderThickness="0,1,0,0"
                                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind Tint}" CornerRadius="12" Padding="0,3"
                                                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind ScoreText}" Foreground="{x:Bind Color}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Ipa}" FontSize="26" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Detail}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Visibility="{x:Bind DetailVisibility}" />
                                                <TextBlock Text="{x:Bind Tip}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind TipVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Advice -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Над чем поработать" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{x:Bind local:ReviewPage.VisibleWhenFalse(ViewModel.HasAdvice), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE930;" Foreground="{x:Bind ViewModel.GoodBrush, Mode=OneWay}" />
                            <TextBlock Text="Ошибок в звуках не найдено — так держать!" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Advice}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="n:AdviceItem">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                                Background="{ThemeResource PrimaryContainerBrush}">
                                            <FontIcon Glyph="&#xEA80;" FontSize="18" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{x:Bind TitleRu}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind TipRu}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Border Style="{StaticResource ChipStyle}"
                                                        Visibility="{x:Bind local:ReviewPage.AdviceIpaVisibility(ExpectedIpa, ActualIpa)}">
                                                    <TextBlock Text="{x:Bind local:ReviewPage.AdviceIpa(ExpectedIpa, ActualIpa)}"
                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <TextBlock Text="{x:Bind local:ReviewPage.TimesText(Count)}"
                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
