<Page x:Class="EnglishApp.Views.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Прогресс" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.DonePercent, Mode=OneWay}" Height="10" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" FontSize="16" Padding="0,3" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Самые трудные звуки" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Weak}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:PhonemeStat"><TextBlock Text="{x:Bind Text}" Padding="0,3" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
