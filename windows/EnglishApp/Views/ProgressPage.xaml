<Page x:Class="EnglishApp.Views.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models"
      xmlns:vm="using:EnglishApp.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="Прогресс" Style="{StaticResource TitleTextBlockStyle}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalWords, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="слов прочитано" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TextsDone, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="текстов пройдено" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Streak, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="серия" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Minutes, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="минут практики" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Уровень игрока" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.XpLine, Mode=OneWay}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.XpPercent, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Точность произношения (последние оценки)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Canvas x:Name="ScoreCanvas" Height="170" SizeChanged="OnScoreCanvasSizeChanged"
                            Visibility="{x:Bind ViewModel.HasScores, Mode=OneWay}" />
                    <TextBlock Text="Пока нет оценённых чтений. Прочитайте текст вслух, и здесь появится график."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.NoScores, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Минуты по неделям" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid x:Name="WeeksHost" Height="150" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Тексты по уровням" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Levels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="18" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:LevelProgress">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Grid Width="64" Height="64">
                                        <ProgressRing IsActive="True" IsIndeterminate="False" Minimum="0" Maximum="100" Width="64" Height="64"
                                                      Value="{x:Bind Percent}" />
                                        <TextBlock Text="{x:Bind Level}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Самые трудные звуки" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Weak}" Visibility="{x:Bind ViewModel.HasWeak, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:WeakSound">
                                <TextBlock Text="{x:Bind Detail}" Padding="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Данных пока недостаточно: звуки появятся после нескольких оценённых чтений."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.NoWeak, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.BadgesLine, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView ItemsSource="{x:Bind ViewModel.Badges}" SelectionMode="None" IsItemClickEnabled="False">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BadgeItem">
                                <StackPanel Width="150" Spacing="4" Opacity="{x:Bind Opacity}" Padding="4">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Glyph}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
