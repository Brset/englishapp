<Page x:Class="EnglishApp.Views.ShadowingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Active, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Counter, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                    <RichTextBlock x:Name="SentenceBlock" FontSize="26" LineHeight="40" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Послушать" Command="{x:Bind ViewModel.ListenCommand}" />
                        <Button Content="Слушать и повторять" Command="{x:Bind ViewModel.ShadowCommand}" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" />
                        <Button Content="Повторить" Command="{x:Bind ViewModel.RepeatCommand}" IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" FontSize="44" FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.ResultBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.CoverageText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Назад" Command="{x:Bind ViewModel.PrevCommand}" />
                        <Button Content="Дальше" Command="{x:Bind ViewModel.NextCommand}" />
                        <Button Content="Завершить" Command="{x:Bind ViewModel.FinishCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Finished, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Итог" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Ещё раз" Command="{x:Bind ViewModel.RestartCommand}" />
                        <Button Content="К тексту" Click="OnBack" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.NoText, Mode=OneWay}">
                <FontIcon Glyph="&#xE767;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Выберите текст в библиотеке" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="В шэдоуинге вы слушаете предложение и сразу повторяете его вслух."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button Content="Открыть библиотеку" Click="OnLibrary" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
