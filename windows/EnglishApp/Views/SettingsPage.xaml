<Page x:Class="EnglishApp.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource TitleTextBlockStyle}" />
            <ComboBox Header="Акцент (озвучка и транскрипция)" Width="300" ItemsSource="{x:Bind ViewModel.Accents}"
                      SelectedIndex="{x:Bind ViewModel.AccentIndex, Mode=TwoWay}" />
            <ComboBox Header="Строгость оценки" Width="300" ItemsSource="{x:Bind ViewModel.Strictnesses}"
                      SelectedIndex="{x:Bind ViewModel.StrictnessIndex, Mode=TwoWay}" />
            <ComboBox Header="Микрофон" Width="400" ItemsSource="{x:Bind ViewModel.Mics}"
                      SelectedIndex="{x:Bind ViewModel.MicIndex, Mode=TwoWay}" />
            <ComboBox Header="Тема" Width="300" ItemsSource="{x:Bind ViewModel.Themes}"
                      SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.Info}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
