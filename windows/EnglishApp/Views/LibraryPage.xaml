<Page x:Class="EnglishApp.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models"
      xmlns:c="using:EnglishApp.Converters">
    <Page.Resources>
        <!-- Level filter pill -->
        <Style x:Key="LibraryPillStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="56" />
        </Style>
        <!-- Library card container: card surface with the GridView's own hover / press states -->
        <Style x:Key="LibraryCardItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        </Style>
        <Style x:Key="LibraryLevelChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="2">
            <TextBlock Text="Библиотека" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Тексты для чтения вслух — от A1 до C2. Выберите уровень и начните читать."
                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Level pills -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="LevelPillAll" Tag="Все" Content="Все" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick" />
                    <ToggleButton x:Name="LevelPillA1" Tag="A1" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource LevelA1Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="A1" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LevelPillA2" Tag="A2" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource LevelA2Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="A2" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LevelPillB1" Tag="B1" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource LevelB1Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="B1" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LevelPillB2" Tag="B2" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource LevelB2Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="B2" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LevelPillC1" Tag="C1" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource LevelC1Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="C1" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LevelPillC2" Tag="C2" Style="{StaticResource LibraryPillStyle}" Click="OnLevelPillClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource LevelC2Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="C2" />
                        </StackPanel>
                    </ToggleButton>
            </StackPanel>
        </ScrollViewer>

        <!-- Search + other filters -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AutoSuggestBox x:Name="SearchBox" Header="Поиск" PlaceholderText="Название или слово из текста" QueryIcon="Find"
                            MinWidth="220" VerticalAlignment="Bottom"
                            Text="{x:Bind ViewModel.SearchText, Mode=OneWay}" TextChanged="OnSearchTextChanged" />
            <ComboBox Grid.Column="1" Header="Жанр" MinWidth="170" ItemsSource="{x:Bind ViewModel.Genres}"
                      SelectedItem="{x:Bind ViewModel.SelectedGenre, Mode=TwoWay}" VerticalAlignment="Bottom" />
            <ComboBox Grid.Column="2" Header="Статус" MinWidth="150" ItemsSource="{x:Bind ViewModel.Statuses}"
                      SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,8,0,0" Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                       Style="{StaticResource CaptionSecondaryStyle}" />
        </Grid>

        <!-- Results -->
        <GridView x:Name="Cards" Grid.Row="3" Margin="0,0,-12,0" Padding="0"
                  ItemsSource="{x:Bind ViewModel.Items}" IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="OnItemClick" SizeChanged="OnCardsSizeChanged"
                  ItemContainerStyle="{StaticResource LibraryCardItemStyle}">
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="312" ItemHeight="208" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="m:TextSummary">
                    <Grid Padding="16,14" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chips: level (coloured) + genre -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid VerticalAlignment="Center">
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelA1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelA1(Level)}" />
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelA2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelA2(Level)}" />
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelB1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelB1(Level)}" />
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelB2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelB2(Level)}" />
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelC1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelC1(Level)}" />
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelC2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelC2(Level)}" />
                                <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource PrimaryBrush}" Visibility="{x:Bind c:LibraryFormat.LevelOther(Level)}" />
                                <TextBlock Text="{x:Bind Level}" Style="{StaticResource LibraryLevelChipTextStyle}" />
                            </Grid>
                            <Border Style="{StaticResource ChipStyle}" Padding="10,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Genre}" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{x:Bind TitleEn}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="16" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{x:Bind TitleRu}" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                        <!-- Reading history / pending badge -->
                        <StackPanel Grid.Row="3" Spacing="2" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ScoreLine}" Visibility="{x:Bind ScoreVisibility}"
                                       Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind BadgeText}" Visibility="{x:Bind BadgeVisibility}"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>

                        <!-- Footer: words, status, best score -->
                        <Grid Grid.Row="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind c:LibraryFormat.WordsText(WordCount)}" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind c:LibraryFormat.StatusGlyph(Status)}" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind StatusRu}" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind c:LibraryFormat.HasScore(BestScore)}"
                                        ToolTipService.ToolTip="Лучший результат">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource ScoreGoodBrush}" Visibility="{x:Bind c:LibraryFormat.ScoreGood(BestScore)}" />
                                    <Ellipse Fill="{ThemeResource ScoreFairBrush}" Visibility="{x:Bind c:LibraryFormat.ScoreFair(BestScore)}" />
                                    <Ellipse Fill="{ThemeResource ScorePoorBrush}" Visibility="{x:Bind c:LibraryFormat.ScorePoor(BestScore)}" />
                                </Grid>
                                <TextBlock Text="{x:Bind c:LibraryFormat.ScoreText(BestScore)}"
                                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Ничего не найдено" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Попробуйте другой уровень, жанр или поисковый запрос."
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <Button Content="Сбросить фильтры" Click="OnResetFilters" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Page>
