<Page x:Class="EnglishApp.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Библиотека" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox Header="Уровень" Width="120" ItemsSource="{x:Bind ViewModel.Levels}"
                      SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}" />
            <ComboBox Header="Жанр" Width="180" ItemsSource="{x:Bind ViewModel.Genres}"
                      SelectedItem="{x:Bind ViewModel.SelectedGenre, Mode=TwoWay}" />
            <ComboBox Header="Статус" Width="160" ItemsSource="{x:Bind ViewModel.Statuses}"
                      SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" />
            <TextBox Header="Поиск" Width="280" PlaceholderText="Название или слово из текста"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" IsItemClickEnabled="True"
                  SelectionMode="None" ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:TextSummary">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{x:Bind TitleEn}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind TitleRu}" />
                        <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ScoreLine}" Visibility="{x:Bind ScoreVisibility}" />
                        <TextBlock Text="{x:Bind BadgeText}" Visibility="{x:Bind BadgeVisibility}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
