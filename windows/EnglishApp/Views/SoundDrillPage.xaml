<Page x:Class="EnglishApp.Views.SoundDrillPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Тренировка звука" Style="{StaticResource TitleTextBlockStyle}" />
            <ComboBox Header="Звук" Width="360" ItemsSource="{x:Bind ViewModel.Sounds}" DisplayMemberPath="Title"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Как произносить" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Padding="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasPairs, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.PairCounter, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.WordText, Mode=OneWay}" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.PairText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Послушать" Command="{x:Bind ViewModel.ListenCommand}" />
                        <Button Content="Повторить" Command="{x:Bind ViewModel.SayCommand}" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" />
                        <Button Content="Следующая пара" Command="{x:Bind ViewModel.NextCommand}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" FontSize="44" FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.ResultBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.HeardText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Для этого звука нет упражнений с парами слов." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.NoPairs, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
