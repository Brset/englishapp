<Page x:Class="EnglishApp.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Главная" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                     Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.Warning, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StreakText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Продолжить" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ContinueText.TitleEn, Mode=OneWay, FallbackValue='Нет начатых текстов'}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ContinueText.Subtitle, Mode=OneWay, FallbackValue=''}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Продолжить чтение" Click="OnContinue" Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasContinue, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Текст дня" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayText.TitleEn, Mode=OneWay, FallbackValue='Библиотека пуста'}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayText.TitleRu, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayText.DescriptionRu, Mode=OneWay, FallbackValue=''}"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Читать" Click="OnToday" Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
