<Page x:Class="EnglishApp.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:EnglishApp.Converters">
    <Page.Resources>
        <Style x:Key="HomeStatCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="HomeStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HomeStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HomeChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,3" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Wide window: four stat cards in one row (default layout below). -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow window: 2 x 2 grid of stat cards. -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatGap2.Width" Value="0" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatGap3.Width" Value="0" />
                        <Setter Target="StatCol3.Width" Value="0" />
                        <Setter Target="StatTile2.(Grid.Row)" Value="1" />
                        <Setter Target="StatTile2.(Grid.Column)" Value="0" />
                        <Setter Target="StatTile2.Margin" Value="0,12,0,0" />
                        <Setter Target="StatTile3.(Grid.Row)" Value="1" />
                        <Setter Target="StatTile3.(Grid.Column)" Value="2" />
                        <Setter Target="StatTile3.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}"
                        HorizontalAlignment="Stretch" Spacing="24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Header -->
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Готовы потренировать произношение? Вот где вы остановились."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                         Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.Warning, Mode=OneWay}" />

                <!-- Stats row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="StatGap2" Width="12" />
                        <ColumnDefinition x:Name="StatCol2" Width="*" />
                        <ColumnDefinition x:Name="StatGap3" Width="12" />
                        <ColumnDefinition x:Name="StatCol3" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource HomeStatCardStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.StreakText, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Серия" Style="{StaticResource HomeStatLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#x1F525;" FontFamily="Segoe UI Emoji" FontSize="24" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.StreakValue, Mode=OneWay}" Style="{StaticResource HomeStatValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.StreakCaption, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource HomeStatCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Пройдено" Style="{StaticResource HomeStatLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource ScoreGoodBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TextsDoneValue, Mode=OneWay}" Style="{StaticResource HomeStatValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TextsDoneCaption, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatTile2" Grid.Column="4" Style="{StaticResource HomeStatCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Средний лучший результат" Style="{StaticResource HomeStatLabelStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="20" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.AvgBestValue, Mode=OneWay}" Style="{StaticResource HomeStatValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="оценка произношения" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatTile3" Grid.Column="6" Style="{StaticResource HomeStatCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Словарь" Style="{StaticResource HomeStatLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A4;" FontSize="20" Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.WordsDueValue, Mode=OneWay}" Style="{StaticResource HomeStatValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WordsDueCaption, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hero: continue reading -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <!-- Has a started text -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasContinue, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE736;" FontSize="16" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                <TextBlock Text="Продолжить чтение" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ContinueText.TitleEn, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ContinueText.TitleRu, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid VerticalAlignment="Center">
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelA1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelA1(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelA2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelA2(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelB1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelB1(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelB2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelB2(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelC1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelC1(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelC2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelC2(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource PrimaryBrush}" Visibility="{x:Bind c:LibraryFormat.LevelOther(ViewModel.ContinueLevel), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.ContinueLevel, Mode=OneWay}" Style="{StaticResource HomeChipTextStyle}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.ContinueText.Subtitle, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Click="OnContinue" Style="{StaticResource AccentButtonStyle}" Margin="0,6,0,0"
                                    Padding="24,10" FontSize="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="Продолжить" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Empty state: nothing started yet -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.NoContinue, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8F1;" FontSize="32" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                            <TextBlock Text="Начните первый текст" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Выберите в библиотеке текст своего уровня — когда вы начнёте читать, он появится здесь."
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Click="OnOpenLibrary" Style="{StaticResource AccentButtonStyle}" Margin="0,6,0,0"
                                    Padding="24,10" FontSize="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                                    <TextBlock Text="Открыть библиотеку" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Text of the day -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Текст дня" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid VerticalAlignment="Center">
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelA1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelA1(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelA2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelA2(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelB1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelB1(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelB2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelB2(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelC1Brush}" Visibility="{x:Bind c:LibraryFormat.LevelC1(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource LevelC2Brush}" Visibility="{x:Bind c:LibraryFormat.LevelC2(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <Border CornerRadius="{StaticResource PillCornerRadius}" Background="{ThemeResource PrimaryBrush}" Visibility="{x:Bind c:LibraryFormat.LevelOther(ViewModel.TodayLevel), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.TodayLevel, Mode=OneWay}" Style="{StaticResource HomeChipTextStyle}" />
                                    </Grid>
                                    <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.TodayText.Genre, Mode=OneWay, FallbackValue=''}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TodayText.TitleEn, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.TodayText.TitleRu, Mode=OneWay, FallbackValue=''}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.TodayText.DescriptionRu, Mode=OneWay, FallbackValue=''}"
                                           TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                                <Button Click="OnToday" Margin="0,4,0,0" Padding="16,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE736;" FontSize="14" />
                                        <TextBlock Text="Читать" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Empty state: no content -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.NoToday, Mode=OneWay}"
                                        HorizontalAlignment="Center" Padding="0,12">
                                <FontIcon Glyph="&#xE7C3;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Библиотека пуста" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Тексты появятся здесь, как только будет доступна база контента."
                                           Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
