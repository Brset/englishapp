<Page x:Class="EnglishApp.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:EnglishApp.Models">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                     Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.Warning, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="96" Height="96">
                            <ProgressRing IsActive="True" IsIndeterminate="False" Minimum="0" Maximum="100" Width="96" Height="96"
                                          Value="{x:Bind ViewModel.GoalPercent, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.GoalText, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Цель на день" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.GoalCaption, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🔥" FontSize="32" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Серия" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StreakText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LevelLine, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.LevelPercent, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Продолжить чтение" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasContinue, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ContinueText.TitleEn, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ContinueLine, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ContinuePercent, Mode=OneWay}" />
                        <Button Content="Продолжить" Click="OnContinue" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.NoContinue, Mode=OneWay}">
                        <TextBlock Text="Пока нет начатых текстов. Выберите первый в библиотеке."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Открыть библиотеку" Click="OnLibrary" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Текст дня" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayText.TitleEn, Mode=OneWay, FallbackValue='Библиотека пуста'}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayText.TitleRu, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayLine, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayText.DescriptionRu, Mode=OneWay, FallbackValue=''}"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Читать" Click="OnToday" Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Слабые звуки" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WeakSounds}" Visibility="{x:Bind ViewModel.HasWeak, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:WeakSound">
                                <Button Content="{x:Bind Chip}" Tag="{x:Bind Phoneme}" Click="OnWeakSound" FontSize="18" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Пока мало данных: прочитайте несколько текстов, и здесь появятся звуки, которые стоит потренировать."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.NoWeak, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Минуты за неделю" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid x:Name="WeekHost" Height="130" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
